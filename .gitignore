# Env / secrets
#
# SEC-06: no secret (including AUTH_JWT_PRIVATE_KEY, the RS256 signing key)
# is ever committed — .env holds real values locally and is git-ignored;
# .env.example documents variable names only.
.env
.env.*
!.env.example

