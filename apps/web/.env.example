# ---------------------------------------------------------------------------
# GrindStats — apps/web environment variables
#
# Copy this file to .env (or .env.local) and fill in the values.
# Never commit .env to version control.
# ---------------------------------------------------------------------------

# Auth client mode.
#   Unset or "true"  → in-memory mock client (default for local dev, no server needed)
#   Any other value  → reserved for the future generated HTTP client
#                      (throws "not implemented" until that client is built)
VITE_AUTH_MOCK=true
