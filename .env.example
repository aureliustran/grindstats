# ---------------------------------------------------------------------------
# GrindStats — root environment variables (docker-compose + services/monolith)
#
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres (also consumed by docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=grindstats
POSTGRES_PASSWORD=grindstats
POSTGRES_DB=grindstats
POSTGRES_SSLMODE=disable

# Redis (also consumed by docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# services/monolith HTTP server
SERVER_PORT=8080

# ─── Auth (AUTH-001, AUTH-002, AUTH-003) ──────────────────────────────────────
#
# JWT RS256 signing key, as the PEM value itself — not a file path. Generate
# one:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#
# and paste the whole PEM block (including the BEGIN/END lines) into your
# real .env, quoted, as one multi-line value:
#
#   AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcw...
#   -----END PRIVATE KEY-----"
#
# The public half is derived automatically — nothing else to generate or
# paste. If your shell or secrets manager can't hold a multi-line value,
# AUTH_JWT_PRIVATE_KEY also accepts the same PEM on one line with literal
# \n in place of real newlines.
AUTH_JWT_PRIVATE_KEY=

# Only set when rotating keys (SEC-02's two-key verification window): the
# outgoing key's PUBLIC PEM, so tokens it already signed keep verifying while
# AUTH_JWT_PRIVATE_KEY signs with the new one. Empty in the normal case.
# Multiple previous keys are separated by a blank line.
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=

# Cookie security. Set false for plain-http local dev; always true in production.
AUTH_COOKIE_SECURE=

# HIBP k-anonymity password-breach check (D3). Set false to disable in local dev.
AUTH_HIBP_ENABLED=

# Google OAuth2 application credentials (register at console.cloud.google.com).
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=

# HMAC key for signing the OAuth state cookie (32 random bytes, hex-encoded).
# Generate with: openssl rand -hex 32
AUTH_GOOGLE_STATE_KEY=

# Mailer mode: "dev" logs deep-links to stdout; any other value is a no-op.
# Production delivery is out of scope for AUTH-001 run 1.
AUTH_MAILER_MODE=

# Public base URL used when composing emailed deep-links (no trailing slash).
AUTH_BASE_URL=
